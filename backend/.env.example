# Example values only. Nothing here is real; copy to .env and replace with your own.

DB_URL=jdbc:postgresql://HOST:5432/DATABASE
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# Demo only. When true, schedulers automatically move paid orders through processing,
# shipping and delivery, and handle returns. Leave false (or unset) in any real deployment.
SIMULATION_ENABLED=false

# Origins allowed to call the API, comma-separated (no trailing slash).
CORS_ALLOWED_ORIGINS=https://your-frontend-origin,https://www.your-frontend-origin

# Base URL of the frontend (no trailing slash). Stripe redirects customers here after checkout.
FRONTEND_URL=https://your-frontend-origin

# Public base URL of this API, no trailing slash. Used as JWT issuer.
BACKEND_URL=https://your-api-origin

# Public base URL of this API, no trailing slash and without /uploads (the app appends it).
STORAGE_PUBLIC_BASE_URL=https://your-api-origin

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=eur

SHIPPO_API_KEY=shippo_test_xxx
SHIPPO_BASE_URL=https://api.goshippo.com
